{
  "name": "poolindex-desktop",
  "productName": "PoolIndex",
  "version": "0.1.3",
  "private": true,
  "author": "Lior Elbaz, Israel",
  "license": "UNLICENSED",
  "description": "PoolIndex desktop client for Windows and macOS. Loads https://poolindex.app. No server secrets.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "dist:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --x64 --arm64 --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --x64 --arm64 --publish never",
    "check-secrets": "node check-secrets.cjs",
    "icon": "node generate-ico.cjs && node generate-installer-bitmaps.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.4"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^26.0.12"
  }
}
