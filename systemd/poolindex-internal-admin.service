[Unit]
Description=PoolIndex internal downloads console (127.0.0.1 only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/lior/claimscout
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/bin
EnvironmentFile=-/home/lior/claimscout/.env
ExecStart=/usr/bin/node --import tsx /home/lior/claimscout/scripts/internal-download-admin.ts
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
MemoryMax=256M

[Install]
WantedBy=default.target
