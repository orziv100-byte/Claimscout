# GITHUB_TOKEN=ghp_optional_raises_rate_limits
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com
# OP_RPC_URL=https://optimism-rpc.publicnode.com
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Public deploys (production, preview, staging): set NODE_ENV=production on the process.
# Never use the GitHub-known fallbacks (dev-only-poolindex-plan-secret / session).
# Unset NODE_ENV is treated as public and those fallbacks are refused.
# POOLINDEX_PLAN_SECRET=change-me-in-production
# POOLINDEX_PAID_KEYS=your-poolindex-pro-key
# POOLINDEX_PLAN=free
# POOLINDEX_SESSION_SECRET=change-me-session-secret
# Extra operator QA emails for many public wallet checks (orziv100@gmail.com is already in code for Closed Beta).
# Daily monitor still caps at five addresses per account.
# POOLINDEX_UNLIMITED_WALLET_EMAILS=qa@example.com
# POOLINDEX_SECURE_COOKIES=1
# TRUST_PROXY only behind cloudflared on this host (Node bound to 127.0.0.1).
# clientIp() then reads CF-Connecting-IP only. X-Real-IP / X-Forwarded-For /
# Forwarded / X-Client-IP are ignored even when this is 1 — those are spoofable
# through the tunnel. Auth login/register/forgot also bucket by email, not IP alone.
# POOLINDEX_TRUST_PROXY=1
# JSON remains the live account store. SQLite WAL dual-writes when var/beta/poolindex.sqlite exists.
# Do not set POOLINDEX_STORE=sqlite until a cutover is explicitly approved.
# POOLINDEX_STORE=json
# Force public-runtime secret checks even in next dev:
# POOLINDEX_PUBLIC_DEPLOY=1
# POOLINDEX_BETA_DIR=var/beta
# POOLINDEX_BOOTSTRAP_INVITE=change-me-operator-invite
# Contact addresses — required before Closed Beta launch (placeholders are not launch-ready)
# POOLINDEX_CONTACT_SUPPORT=support@example.com
# POOLINDEX_CONTACT_PRIVACY=privacy@example.com
# POOLINDEX_CONTACT_SECURITY=security@example.com
# POOLINDEX_CONTACT_ACCESSIBILITY=accessibility@example.com
# POOLINDEX_CONTACT_LEGAL=legal@example.com
# Mail — Resend (production). Keep RESEND_API_KEY in gitignored .env only.
# POOLINDEX_PUBLIC_URL=https://poolindex.app
# POOLINDEX_MAIL_PROVIDER=resend
# POOLINDEX_MAIL_FROM=PoolIndex <noreply@poolindex.app>
# POOLINDEX_MAIL_REPLY_TO=support@poolindex.app
# PayPal Sandbox only. Put real Client ID / Secret in gitignored `.env`, never here.
# PAYPAL_ENV=live is ignored. Checkout stays sandbox. Never send secrets to the client.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Google Sign-In (server-side only). Paste values from Google Cloud Console into gitignored `.env`.
# Authorized redirect URI: https://poolindex.app/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Internal downloads console — loopback only. Never add this port to Cloudflare.
# Open on the server: http://127.0.0.1:43148/  (not poolindex.app, not the desktop app)
# POOLINDEX_INTERNAL_ADMIN_PORT=43148
# Optional overrides after the server creates Sandbox catalog objects:
# PAYPAL_PRODUCT_ID=
# PAYPAL_PLAN_MONTHLY_ID=
# PAYPAL_PLAN_YEARLY_ID=
# PAYPAL_WEBHOOK_ID=
