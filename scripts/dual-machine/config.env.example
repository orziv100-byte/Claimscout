# Copy to config.env (gitignored). Do not put passwords, tokens, or private keys here.

# linux  = claimscoutserver / this host (backup + independent compute)
# windows = main development/control PC
CLAIM_SCOUT_ROLE=linux

# Project working copy. Empty = directory that contains this scripts/ folder.
CLAIM_SCOUT_ROOT=

# Append-only snapshot root. Must stay outside the live working copy.
CLAIM_SCOUT_BACKUP_ROOT=

# Optional SSH peer for sending a NEW snapshot (never a live-tree mirror).
# Example: claimscoutserver
CLAIM_SCOUT_PEER_HOST=
CLAIM_SCOUT_PEER_USER=
CLAIM_SCOUT_PEER_PATH=

# Retention: never drop below MIN, even if older than KEEP.
CLAIM_SCOUT_KEEP_SNAPSHOTS=14
CLAIM_SCOUT_MIN_SNAPSHOTS=3

# Refuse a snapshot whose file count is below this fraction of the last good one.
CLAIM_SCOUT_SHRINK_LIMIT=0.5

# Heavy-work gates (crash/resource safety).
CLAIM_SCOUT_MIN_RAM_MB=3072
CLAIM_SCOUT_MAX_LOAD_PER_CPU=1.75
CLAIM_SCOUT_MAX_DISK_PCT=88
